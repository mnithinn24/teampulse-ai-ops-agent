# GitHub Configuration
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo1,owner/repo2

# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=engineer@example.com
JIRA_API_TOKEN=jira_api_token_here
JIRA_PROJECT_KEY=PROJ

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID= C0123456789
SLACK_APPROVER_IDS=
MAX_FLAGS_IN_BRIEFING=10
DRY_RUN_ACTIONS=false

# LLM Configuration (never hardcode models in code)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=low
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ENABLED=true
LLM_TIMEOUT_SECONDS=60

# Thresholds
STALE_PR_DAYS=7
STALE_TICKET_DAYS=14
ABANDONED_PR_DAYS=180
MAX_ITEMS_IN_PROMPT=15
MAX_COMMIT_LOOKUPS=15

# Database Configuration (MySQL for dev, SQLite in-memory for tests)
DATABASE_URL=

# Localization
TIMEZONE=Asia/Kolkata

# Scheduler Configuration
ENABLE_SCHEDULER=false
MORNING_BRIEFING_TIME=09:30
EVENING_BRIEFING_TIME=17:30

# API & Security
ADMIN_API_KEY=your-secret-admin-api-key
QUERY_RATE_LIMIT_PER_MINUTE=5
QUERY_CACHE_TTL_SECONDS=300


